# ==========================================================
# MixProduct Telegram Bot Configuration (Server-Side ONLY)
# ==========================================================
# ВНИМАНИЕ: Эти переменные используются ТОЛЬКО на бэкенде.
# Они НИКОГДА не попадают во фронтенд-код и браузер.
#
# Администратор магазина: @Irkinov_Shuhratbek
# Официальный канал: @mixproduct_uz
#
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ:
# 1. Откройте Telegram и перейдите к @BotFather (https://t.me/BotFather)
# 2. Отправьте команду /newbot и задайте имя боту (например, MixProduct Bot)
# 3. Скопируйте полученный HTTP API Token и вставьте в TELEGRAM_BOT_TOKEN ниже:
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 4. Как получить TELEGRAM_CHAT_ID:
#    Вариант А (личные сообщения администратору):
#    - Администратор (@Irkinov_Shuhratbek) нажимает "Start" в созданном боте
#    - Переходит в @userinfobot и копирует свой числовой ID (например: 123456789)
#
#    Вариант Б (группа/чат магазина):
#    - Создайте группу в Telegram, добавьте туда @Irkinov_Shuhratbek и вашего бота
#    - Дайте боту права администратора на отправку сообщений
#    - ID группы (обычно с минусом, например: -1001234567890)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Порт Express сервера для режима production
PORT=3001
